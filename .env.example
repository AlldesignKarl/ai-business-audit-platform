# ============================================================================
# AI Business Audit Platform — variables de entorno
# Copia este archivo a .env y rellena los valores. Nada de esto tiene un
# valor real de ejemplo: todo lo que falte se detecta en /system-health y
# la funcionalidad asociada queda deshabilitada (no simulada) hasta que se
# configure.
# ============================================================================

# --- Núcleo de la app ---
NODE_ENV=development
APP_URL=http://localhost:3000
# Clave usada para firmar sesiones (NextAuth) y JWT internos. Genera una con:
# openssl rand -base64 32
AUTH_SECRET=
# Clave de 32 bytes en base64 para cifrar credenciales de conectores en BD.
# Genera una con: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Base de datos (PostgreSQL vía Prisma) ---
DATABASE_URL=postgresql://app:app@localhost:5432/business_audit

# --- Colas / background jobs (Redis) ---
REDIS_URL=redis://localhost:6379

# --- Prospección: fuentes de negocios públicas ---
# Google Places API (New) - https://developers.google.com/maps/documentation/places/web-service
# Sin esta clave, el conector de Google Places queda deshabilitado (no se
# generan resultados simulados).
GOOGLE_PLACES_API_KEY=
# Google My Business / Business Profile API (requiere verificación de negocio
# por Google; opcional, solo para clientes que autorizan la conexión)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- IA / Orchestrator ---
# Sin ANTHROPIC_API_KEY el AI Orchestrator usa un proveedor determinista
# basado en reglas (NullProvider) en lugar de generar texto con IA.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_COMPLEX=claude-opus-4-5
ANTHROPIC_MODEL_SIMPLE=claude-haiku-4-5
# Límite de gasto diario en IA por organización (USD). 0 = sin límite.
AI_DAILY_BUDGET_USD=20

# --- Email transaccional / comercial ---
# Configura SOLO uno de los dos proveedores. Sin ninguno, los emails se
# registran en la tabla `Email` con estado QUEUED y no se envían realmente.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AI Business Audit <no-reply@example.com>"
RESEND_API_KEY=

# --- WhatsApp Business (Meta Cloud API oficial) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Meta Graph API (Instagram / Facebook Business) ---
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/connectors/meta/callback

# --- Google Calendar / Analytics (reutilizan GOOGLE_OAUTH_*) ---
GA4_PROPERTY_ID=

# --- Almacenamiento de informes PDF ---
# Si no se configura, los informes se guardan en el sistema de archivos local
# (./reports-output), pensado solo para desarrollo.
REPORTS_STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Discord (opcional, logs operativos internos del equipo, no del cliente) ---
INTERNAL_ALERTS_DISCORD_WEBHOOK_URL=
